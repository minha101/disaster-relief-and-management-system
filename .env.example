# Copy this file to .env  (Windows CMD:  copy .env.example .env)
FLASK_ENV=development
# Leave empty in development: a random key is generated once and stored in instance/secret.key
# In production you MUST set a long random value (python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=

# SQLite (development, default) -> leave DATABASE_URL empty
# MySQL (primary / production):
# DATABASE_URL=mysql+pymysql://drms_user:YOUR_PASSWORD@localhost:3306/drms?charset=utf8mb4
DATABASE_URL=

# true  = tables are created automatically at start (good for SQLite / demo)
# false = use Flask-Migrate (flask db migrate / flask db upgrade), recommended for MySQL production
AUTO_CREATE_TABLES=true

# Set to true only when served over HTTPS
SESSION_COOKIE_SECURE=false

# Optional: password for demo accounts created by seed.py (random one is generated if empty)
DEMO_USER_PASSWORD=
